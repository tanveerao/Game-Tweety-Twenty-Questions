# Copy this file to .streamlit/secrets.toml and fill in your real key.
# .streamlit/secrets.toml is gitignored — never commit your real key.

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: if set, players must enter this passphrase before they can play.
# Leave unset for local dev (no gate). Recommended if you deploy publicly,
# so a stranger with the URL can't run up your API bill.
# APP_PASSPHRASE = "choose-something-only-you-share"
